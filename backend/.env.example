# 服务器配置
NODE_ENV=development
PORT=5000

# API 限流与跨域配置
RATE_LIMIT_ENABLED=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 主数据库配置（业务库 HealthRecordSystem）
DB_USER=sa
DB_PASSWORD=your_password
DB_SERVER=your_server
DB_DATABASE=HealthRecordSystem
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=true

# 第三方数据库只读配置（体检源库，与主库严格分离）
# ⚠️ 必须使用只读账号，仅授予 SELECT 权限
THIRD_DB_USER=third_readonly_user
THIRD_DB_PASSWORD=your_third_db_password
THIRD_DB_SERVER=your_third_db_server
THIRD_DB_DATABASE=JZCIS
THIRD_DB_ENCRYPT=true
THIRD_DB_TRUST_CERTIFICATE=true
THIRD_DB_REQUEST_TIMEOUT=30000
THIRD_DB_CONNECTION_TIMEOUT=30000
THIRD_DB_POOL_MAX=10
THIRD_DB_RETRY_COUNT=3
THIRD_DB_RETRY_DELAY=1000

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# 前端URL配置
FRONTEND_URL=http://localhost:8080

# 日志配置
LOG_LEVEL=info
APP_VERSION=1.2.1

# DeepSeek API配置
# 获取API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# PDF转换API配置
# 方式1: 使用完整URL配置（推荐）
PDF_CONVERT_URL=http://localhost:4000/convert

# 方式2: 分别配置IP和端口（仅当不使用 PDF_CONVERT_URL 时生效）
PDF_HOST=localhost
PDF_PORT=4000

# PDF转换超时时间（毫秒）
PDF_CONVERT_TIMEOUT=30000

# 对比报告配置
COMPARISON_REPORT_MAX_SELECTIONS=3

# 安全自检脚本可选配置（仅 backend/scripts/security-smoke-check.js 使用）
# SMOKE_BASE_URL=http://127.0.0.1:5000
# SMOKE_USERNAME=admin
# SMOKE_PASSWORD=admin123
# SMOKE_CHECK_RATE_LIMIT=false
